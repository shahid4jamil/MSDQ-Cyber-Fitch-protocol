rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shahid4jamil@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGameSession(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'gameType', 'status', 'lastActiveAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() <= 100 &&
        data.gameType in ['ludo', 'crash', 'dice', 'coinflip', 'wheel', 'numbers', 'colors'] &&
        data.status in ['ACTIVE', 'COMPLETED', 'ABANDONED'] &&
        data.lastActiveAt is number &&
        (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
        (!('roomCode' in data) || (data.roomCode is string && data.roomCode.size() <= 64)) &&
        (!('roundId' in data) || (data.roundId is string && data.roundId.size() <= 128)) &&
        (!('stake' in data) || (data.stake is number && data.stake >= 0)) &&
        (!('reconnectToken' in data) || (data.reconnectToken is string && data.reconnectToken.size() <= 128));
    }

    // User Sovereign Account Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && isAdmin())
      );
      allow update: if isValidId(userId) && isSignedIn() && (
        isAdmin() || (
          // Self-profile updates: user can update general fields but CANNOT self-elevate role, KYC status, or account standing
          request.auth.uid == userId &&
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (!('kycStatus' in resource.data) || request.resource.data.kycStatus == resource.data.kycStatus) &&
          (!('status' in resource.data) || request.resource.data.status == resource.data.status)
        ) || (
          // P2P Transfer recipient credit: a signed-in peer can only increase recipient balance, leaving all security/identity fields intact
          request.auth.uid != userId &&
          (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('email' in resource.data) || request.resource.data.email == resource.data.email) &&
          (!('walletAddress' in resource.data) || request.resource.data.walletAddress == resource.data.walletAddress) &&
          (!('kycStatus' in resource.data) || request.resource.data.kycStatus == resource.data.kycStatus) &&
          (!('status' in resource.data) || request.resource.data.status == resource.data.status) &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (request.resource.data.msdqBalance >= resource.data.msdqBalance)
        )
      );
      allow delete: if isAdmin();
    }

    // User Subcollections (e.g. referrals, miningSessions)
    match /users/{userId}/referrals/{refId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == refId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == refId || isAdmin());
    }

    match /users/{userId}/miningSessions/{sessionId} {
      allow read, write: if isValidId(userId) && isValidId(sessionId) && isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // Immutable Ledger Transactions
    match /transactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(txId) && isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.type in ['receive', 'reward', 'referral_bonus', 'REFERRAL_REWARD', 'task_reward'] && isSignedIn()) ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // KYC Identity Verification Applications
    match /kyc_applications/{appId} {
      allow get: if isValidId(appId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isValidId(appId) && isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isValidId(appId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Active Game Sessions for State Resumption & Matchmaking
    match /game_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(sessionId) && isSignedIn() &&
        isValidGameSession(request.resource.data) &&
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isValidId(sessionId) && isSignedIn() &&
        isValidGameSession(request.resource.data) &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isValidId(sessionId) && isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Admin configuration node
    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Authoritative Mining Sessions
    match /mining_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(sessionId) && isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isValidId(sessionId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Dedicated Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
